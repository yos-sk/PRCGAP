# Main entrypoint of the workflow.
# Please follow the best practices:
# https://snakemake.readthedocs.io/en/stable/snakefiles/best_practices.html,
# in particular regarding the standardized folder structure mentioned there.


# load configuration
# -----------------------------------------------------
# Config file must be specified via --configfile when running snakemake.
# Example: snakemake --configfile /path/to/config.yaml



# load rules
# -----------------------------------------------------
include: "rules/commons.smk"
include: "rules/process.smk"


# optional messages, log and error handling
# -----------------------------------------------------
onstart:
    print("\n--- Analysis started ---\n")


onsuccess:
    print("\n--- Workflow finished! ---\n")


onerror:
    print("\n--- An error occurred! ---\n")


# target rules
# -----------------------------------------------------
# Always request the leaf outputs of every analysis path; Snakemake's DAG
# resolution pulls in the upstream rules (bam_refiner, nanomonsv_parse/get/
# postprocess, clairs, deepsomatic) automatically.
def get_all_targets():
    # Targets are enumerated per available sequencing type so HiFi-only and
    # ONT-only samples work. Per-sample rules (methylation) use the sample's own
    # seqtypes; tumor/normal callers (nanomonsv, clairs, deepsomatic,
    # copynumber, SV/mutation annotation) use paired_seqtypes(tumor) — the
    # seqtypes present for BOTH the tumor and its paired normal.
    targets = []
    all_samples = list(samples.index.get_level_values("sample"))

    # methylation (per sample, per available seqtype)
    for sample in all_samples:
        for seqtype in sample_seqtypes(sample):
            targets.append("methylation/{}/{}/output".format(sample, seqtype))

    # copynumber (per tumor; uses the primary paired seqtype internally)
    targets.extend(expand("copynumber/{tumor}/output/{tumor}.copynumber.png", tumor=tumors))

    for tumor in tumors:
        seqtypes = paired_seqtypes(tumor)

        # nanomonsv: insert classify (per available seqtype).
        for seqtype in seqtypes:
            targets.append(
                "nanomonsv/{}/{}.nanomonsv.new_result.sv_typed.insert_classified.txt".format(seqtype, tumor))
            # connect is optional (not used in the paper); off by default.
            if config.get("run_nanomonsv_connect", False):
                targets.append(
                    "nanomonsv/{}/{}.nanomonsv.connect.txt".format(seqtype, tumor))
        # nanomonsv merge (combine HiFi+ONT) is optional (not used in the
        # paper); off by default, and only meaningful when both seqtypes exist.
        if config.get("run_nanomonsv_merge", False) and len(seqtypes) >= 2:
            targets.append("nanomonsv/{}.nanomonsv.result.merged.txt".format(tumor))

        # SV annotation + reclassification (per available seqtype)
        for seqtype in seqtypes:
            targets.append(
                "annotate_sv/{}/{}/{}.PRCGAP.nanomonsv_results.annotated.txt".format(tumor, seqtype, tumor))
            targets.append(
                "annotate_sv/{}/{}.{}.PRCGAP.nanomonsv_results.reclassified.txt".format(tumor, tumor, seqtype))

        # point-mutation postprocess leaves + annotation
        # (per caller × per available seqtype; annotation additionally per mode)
        for seqtype in seqtypes:
            for tool in mutation_callers():
                targets.append(
                    "{}_post/{}/{}/{}.haplotyped.bed".format(tool, tumor, seqtype, tumor))
                for mode in ("snv", "indel"):
                    targets.append(
                        "annotate_{}/{}/{}/{}/{}.{}.{}.annotated.txt".format(
                            mode, tumor, tool, seqtype, tumor, tool, mode))

    return targets


rule all:
    input:
        get_all_targets()
    default_target: True
