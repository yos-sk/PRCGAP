# Main entrypoint of the workflow.
# Please follow the best practices:
# https://snakemake.readthedocs.io/en/stable/snakefiles/best_practices.html,
# in particular regarding the standardized folder structure mentioned there.


# load configuration
# -----------------------------------------------------
# Config file must be specified via --configfile when running snakemake.
# Example: snakemake --configfile /path/to/config.yaml



# load rules
# -----------------------------------------------------
include: "rules/commons.smk"
include: "rules/process.smk"


# optional messages, log and error handling
# -----------------------------------------------------
onstart:
    print("\n--- Analysis started ---\n")


# Scratch a successful run no longer needs. Named as glob patterns relative to
# the working directory, and only ever removed once every target is built, so a
# failed or interrupted run keeps everything for inspection. `debug: true` in the
# config (setup_workflow.py --debug) skips the whole step.
#
# On H2009 this is ~150 GB: the methylation workspace alone holds an 89 GB
# filtered BAM, and reference.fa is written once per rule that needs it (5.7 GB
# x 6). All of it is reproducible from the inputs that remain.
_SCRATCH_DIRS = [
    "*/*/workspace",          # copynumber, annotation/<sample>/<step>
    "*/*/*/workspace",        # methylation, annotate_sv, annotate_{snv,indel}
    "*/*/*/*/workspace",
    "*_scatter/*",            # clairs / deepsomatic per-contig scatter
    "bwa_index",
    # A declared output, unlike everything above it, so removing it does make the
    # next invocation rebuild it -- 20 s of staging against 2.9 GB kept.
    "copynumber/reference",
]

# Side products of the nanomonsv postprocess script and the realign step. None of
# them is a rule input or output -- checked against workflow/rules -- so removing
# them leaves the DAG intact and the next run does not rebuild anything.
#
# nanomonsv.new_result.sv_typed.txt is deliberately NOT here. It looks equally
# intermediate but it IS declared output and feeds insert_classify, connect and
# merge, and regenerating it means running nanomonsv postprocess again. The test
# is what a rebuild costs, not whether a path is declared: copynumber/reference
# above is declared too and goes, because restaging it takes 20 s.
_SCRATCH_FILES = [
    "nanomonsv/*/*.nanomonsv.new_result.txt",
    "nanomonsv/*/*.nanomonsv.result.filt.pass_low_vaf.txt",
    "nanomonsv/*/*.nanomonsv.result.filt.pass_low_vaf.bed",
    "nanomonsv/*/*.nanomonsv.result.seq.txt",
    "*_post/*/*/realign/realign_ref.fasta*",   # bwa index of the candidate flanks
]


def _clean_scratch():
    import glob
    import shutil

    def _du(path):
        if os.path.isfile(path):
            return 0 if os.path.islink(path) else os.path.getsize(path)
        return sum(os.path.getsize(os.path.join(root, f))
                   for root, _, files in os.walk(path)
                   for f in files
                   if not os.path.islink(os.path.join(root, f)))

    removed, freed = [], 0
    for pattern in _SCRATCH_DIRS:
        for path in sorted(glob.glob(pattern)):
            if os.path.isdir(path):
                freed += _du(path)
                shutil.rmtree(path, ignore_errors=True)
                removed.append(path)
    for pattern in _SCRATCH_FILES:
        for path in sorted(glob.glob(pattern)):
            if os.path.isfile(path):
                freed += _du(path)
                os.remove(path)
                removed.append(path)

    if removed:
        print("Removed {} scratch path{} ({:.1f} GB):".format(
            len(removed), "" if len(removed) == 1 else "s", freed / 1024 ** 3))
        for path in removed:
            print("  " + path)
        print("Pass --debug to setup_workflow.py to keep them.")


onsuccess:
    print("\n--- Workflow finished! ---\n")
    if not config.get("debug", False):
        _clean_scratch()


onerror:
    print("\n--- An error occurred! ---\n")


# target rules
# -----------------------------------------------------
# Always request the leaf outputs of every analysis path; Snakemake's DAG
# resolution pulls in the upstream rules (bam_refiner, nanomonsv_parse/get/
# postprocess, clairs, deepsomatic) automatically.
def get_all_targets():
    # Targets are enumerated per available sequencing type so HiFi-only and
    # ONT-only samples work. Per-sample rules (methylation) use the sample's own
    # seqtypes; tumor/normal callers (nanomonsv, clairs, deepsomatic,
    # copynumber, SV/mutation annotation) use paired_seqtypes(tumor) — the
    # seqtypes present for BOTH the tumor and its paired normal.
    targets = []
    all_samples = list(samples.index.get_level_values("sample"))

    # methylation (per sample, per available seqtype)
    for sample in all_samples:
        for seqtype in sample_seqtypes(sample):
            targets.append("methylation/{}/{}/output".format(sample, seqtype))

    # copynumber (per tumor; uses the primary paired seqtype internally)
    targets.extend(expand("copynumber/{tumor}/output/{tumor}.copynumber.png", tumor=tumors))

    for tumor in tumors:
        seqtypes = paired_seqtypes(tumor)

        # nanomonsv: insert classify (per available seqtype).
        for seqtype in seqtypes:
            targets.append(
                "nanomonsv/{}/{}.nanomonsv.new_result.sv_typed.insert_classified.txt".format(seqtype, tumor))
            # connect is optional (not used in the paper); off by default.
            if config.get("run_nanomonsv_connect", False):
                targets.append(
                    "nanomonsv/{}/{}.nanomonsv.connect.txt".format(seqtype, tumor))
        # nanomonsv merge (combine HiFi+ONT) is optional (not used in the
        # paper); off by default, and only meaningful when both seqtypes exist.
        if config.get("run_nanomonsv_merge", False) and len(seqtypes) >= 2:
            targets.append("nanomonsv/{}.nanomonsv.result.merged.txt".format(tumor))

        # SV annotation + reclassification (per available seqtype). Requesting
        # the reclassified table is enough -- it is built from annotated.txt, so
        # naming both only restates the dependency.
        for seqtype in seqtypes:
            targets.append(
                "annotate_sv/{}/{}/{}.PRCGAP.nanomonsv_results.reclassified.txt".format(tumor, seqtype, tumor))

        # point-mutation postprocess leaves + annotation
        # (per caller × per available seqtype; annotation additionally per mode)
        for seqtype in seqtypes:
            for tool in mutation_callers():
                targets.append(
                    "{}_post/{}/{}/{}.haplotyped.bed".format(tool, tumor, seqtype, tumor))
                for mode in ("snv", "indel"):
                    targets.append(
                        "annotate_{}/{}/{}/{}/{}.{}.{}.annotated.txt".format(
                            mode, tumor, tool, seqtype, tumor, tool, mode))

    return targets


rule all:
    input:
        get_all_targets()
    default_target: True
